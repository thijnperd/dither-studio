<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The entitlements a signed Dither Studio needs under the hardened runtime.
  Electron runs JavaScript in V8, which needs a JIT and writable-executable
  memory; without these two the signed app dies on launch with a code-signing
  trap rather than a useful message. They are only applied when electron-builder
  actually signs the bundle (a Developer ID is present); an unsigned local build
  ignores them.

  Deliberately absent: com.apple.security.cs.disable-library-validation and any
  network or file entitlement the press does not need. The app is offline and
  reads files through the OS dialogs, so its sandbox story stays as small as
  the program itself.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
